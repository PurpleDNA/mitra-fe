# Copy to .env.local for development. In Vercel, set the same names under
# Project → Settings → Environment Variables (Production and Preview).

# Early-access gate for /app (lib/access.ts). Unset admits nobody.
MITRA_EARLY_ACCESS_CODE=

# WalletConnect / Reown project id (https://cloud.reown.com): mobile and QR wallets in
# the connect modal. Empty offers browser-extension wallets and Coinbase Wallet only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: the policy engine key a new card names. Defaults to the engine's testnet key.
NEXT_PUBLIC_MITRA_POLICY_ENGINE=

# Optional: point chain reads at another node, e.g. an anvil fork (http://127.0.0.1:8545).
NEXT_PUBLIC_RPC_URL=
