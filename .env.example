# Copy to .env.local for development. In Vercel, set the same names under
# Project → Settings → Environment Variables (Production and Preview).

# Early-access gate for /app (lib/access.ts). Unset admits nobody.
# One code per person or team, comma-separated; removing one locks out only its holders.
MITRA_EARLY_ACCESS_CODES=
# The older single shared code, still honoured.
MITRA_EARLY_ACCESS_CODE=

# WalletConnect / Reown project id (https://cloud.reown.com): mobile and QR wallets in
# the connect modal. Empty offers browser-extension wallets and Coinbase Wallet only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: the policy engine key a new card names. Defaults to the engine's testnet key.
NEXT_PUBLIC_MITRA_POLICY_ENGINE=

# Optional: point chain reads at another node, e.g. an anvil fork (http://127.0.0.1:8545).
NEXT_PUBLIC_RPC_URL=

# Accounts: the Supabase project "mitra" (eu-west-2). Both are public by design; row-level
# security decides what a signed-in user can touch.
NEXT_PUBLIC_SUPABASE_URL=https://tjlnxnirtltczjruymnl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Mitra engine: app/api/engine forwards a short allow-list of its endpoints (agent
# registration, card sync, lookups) for signed-in accounts. Public: it is just an address.
NEXT_PUBLIC_MITRA_ENGINE_URL=https://mitra-engine.fly.dev
